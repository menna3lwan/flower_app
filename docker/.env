# Docker Hub image tag for flowersapp.auth (check real tags at hub.docker.com/r/manaarnabil/flowersapp-auth/tags)
AUTH_IMAGE_TAG=latest

# Docker Hub image tag for flowersapp.apigateway (check real tags at hub.docker.com/r/manaarnabil/flowersapp-apigateway/tags)
APIGATEWAY_IMAGE_TAG=latest

# SQL Server SA password (used by sqlserver, flowersapp.auth, and flowersapp.apigateway)
MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# Redis password (used by redis healthcheck and connection strings)
REDIS_PASSWORD=your_redis_password

# JWT signing key used by flowersapp.auth (must be a long random string in production)
JWT_KEY=ReplaceThisWithALongRandomSecretKeyAtLeast32Chars
