{
  // Flutter/Dart debug configurations for the Flowery app. The repo root
  // is the Flutter project itself (no apps/ subfolder), so no custom
  // "cwd" is needed -- these run from the workspace root by default.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flowery",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "Flowery (Profile Mode)",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "Flowery (Release Mode)",
      "program": "lib/main.dart",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    }
  ]
}
