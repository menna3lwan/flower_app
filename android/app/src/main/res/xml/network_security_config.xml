<?xml version="1.0" encoding="utf-8"?>
<!--
  Permits plain-HTTP (cleartext) traffic to local development hosts only.
  The API Gateway (docker/docker-compose.yml) is served over http://, not
  https://, for local development — Android blocks all cleartext traffic
  by default since API 28, so without this config every request to the
  Gateway would fail with a CLEARTEXT_NOT_PERMITTED error before it even
  left the device.

  Scoped to specific hosts (not a blanket usesCleartextTraffic="true") so
  cleartext stays impossible for every other domain, including whatever
  production HTTPS host this app eventually points ApiEndpoints.baseUrl at.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android Emulator's alias for the host machine's loopback. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
